<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <AssemblyName>BARControllerUpdater</AssemblyName>
    <RootNamespace>BARControllerUpdater</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ProductMetadata.cs" Link="Shared\ProductMetadata.cs" />
    <Compile Include="..\Shared\BridgeConsole.cs" Link="Shared\BridgeConsole.cs" />
    <Compile Include="..\Shared\ControllerReleaseModels.cs" Link="Shared\ControllerReleaseModels.cs" />
    <Compile Include="..\Shared\ControllerReleaseSecurity.cs" Link="Shared\ControllerReleaseSecurity.cs" />
    <Compile Include="..\Shared\ControllerReleaseTransaction.cs" Link="Shared\ControllerReleaseTransaction.cs" />
    <Compile Include="..\Shared\ControllerUpdatePolicy.cs" Link="Shared\ControllerUpdatePolicy.cs" />
  </ItemGroup>
</Project>
