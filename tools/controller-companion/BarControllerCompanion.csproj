<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <AssemblyName>BARControllerBridge</AssemblyName>
    <RootNamespace>BARControllerBridge</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Launcher\**\*.cs" />
    <Compile Remove="Installer\**\*.cs" />
    <Compile Remove="Restore\**\*.cs" />
    <Compile Remove="Updater\**\*.cs" />
    <Compile Remove="Bootstrap\**\*.cs" />
    <Compile Remove="Shared\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="ReleaseTests\**\*.cs" />
    <Compile Include="Shared\ProductMetadata.cs" />
    <Compile Include="Shared\EngineSessionTracker.cs" />
    <Compile Include="Shared\BridgeConsole.cs" />
    <Compile Include="Shared\ConsoleInteractionCoordinator.cs" />
    <Compile Include="Shared\ControllerReleaseModels.cs" />
    <Compile Include="Shared\ControllerReleaseSecurity.cs" />
    <Compile Include="Shared\ControllerReleaseTransaction.cs" />
    <Compile Include="Shared\ControllerUpdatePolicy.cs" />
  </ItemGroup>
</Project>
