{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UnderarmCape/underarmcape-bar-controller-support-attempt-01/controller-release-schema-v1.json",
  "title": "BAR Controller Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schemaVersion", "releaseTag", "semanticVersion", "displayVersion",
    "releaseSequence", "releaseChannel", "commitSha", "publishedAtUtc", "repository",
    "package", "minimumUpdaterVersion", "barCompatibility", "compatibilityNotes",
    "requiresLuaUiReset", "releaseSummary", "releaseNotesAsset",
    "configurationPreservation", "installLifecycle", "components"
  ],
  "properties": {
    "kind": { "const": "bar-controller-release-manifest" },
    "schemaVersion": { "const": 1 },
    "releaseTag": { "type": "string", "minLength": 1 },
    "semanticVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayVersion": { "type": "string", "minLength": 1 },
    "releaseSequence": { "type": "integer", "minimum": 1 },
    "releaseChannel": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "publishedAtUtc": { "type": "string", "format": "date-time" },
    "repository": { "const": "UnderarmCape/underarmcape-bar-controller-support-attempt-01" },
    "package": {
      "type": "object",
      "required": ["assetName", "sha256", "byteLength", "format", "detachedIdentity"],
      "properties": {
        "assetName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "format": { "const": "zip" },
        "detachedIdentity": { "type": "boolean" }
      }
    },
    "minimumUpdaterVersion": { "type": "string" },
    "barCompatibility": { "type": "object" },
    "compatibilityNotes": { "type": "string" },
    "requiresLuaUiReset": { "type": "boolean" },
    "releaseSummary": { "type": "string" },
    "releaseNotesAsset": { "type": "string" },
    "configurationPreservation": { "type": "array" },
    "installLifecycle": { "type": "object" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "componentId", "componentType", "sourcePath", "destinationRoot", "destinationPath",
          "sha256", "byteLength", "installPolicy", "replaceBehavior", "mayBeLockedByCompanion",
          "companionMustRestart", "barMustRunLuaUiReset", "optional", "platform", "architecture",
          "configurationBehavior"
        ]
      }
    }
  }
}
